# Dependencies
node_modules/
worker/node_modules/

# Environment variables
.env
worker/.env
*.env

# Output files
worker/outputs/
worker/test-output/
worker/temp-uploads/
worker/content/

# Graphics and large assets (don't push images/videos)
worker/assets/**/*.png
worker/assets/**/*.jpg
worker/assets/**/*.jpeg
worker/assets/**/*.svg
worker/assets/**/*.gif
worker/assets/**/*.mp4
worker/assets/**/*.mov
worker/assets/**/*.m4v

# Fonts (large files, don't push)
worker/assets/fonts/**/*.ttf
worker/assets/fonts/**/*.otf
worker/assets/fonts/**/*.woff
worker/assets/fonts/**/*.woff2

# Keep folder structure but ignore contents
!worker/assets/
!worker/assets/**/
!worker/assets/**/.gitkeep

# Paper backgrounds (also ignored as images)
worker/assets/paper_backgrounds/**/*.png

# Large video files - ALL assets folders are local only, not for git
assets/
!assets/.gitkeep
assets/**/*.mp4
assets/**/*.mov
assets/**/*.m4v
assets/**/*.avi
assets/**/*.mkv
assets/**/*.webm

# Audio files
**/*.m4a
**/*.wav
**/*.mp3
**/*.aac
**/*.flac
worker/content/audio/
worker/content/

# Website assets (large files, already in Firebase/Arweave)
website/img/**/*.jpg
website/img/**/*.jpeg
website/img/**/*.png
website/img/**/*.gif
website/img/**/*.svg
website/fonts/**/*

# Firebase credentials
firebase-key.json
firebase-credentials.json

# Wallet exports (NEVER commit wallet files!)
wallet-export/
*.json
!package.json
!package-lock.json
!tsconfig.json
!vercel.json

# Skyline thumbnail pipeline: these two ARE source, not generated output, and the
# blanket *.json rule above would otherwise silently exclude them from the repo
# (the catalog is the pipeline's durable, versioned source-of-truth, and the
# fixtures are required by tests/website-sync-skyline-meta.test.mjs).
!config/skyline-thumbnail-sources.json
!tests/fixtures/*.json
# Skyline thumbnail visual treatment (source, not generated output).
!config/skyline-thumbnail-treatment.json
# Homepage hero promo clips. Built by scripts/build-hero-promo-catalog.mjs, but
# it IS a committed artifact: WebsitePageGenerator reads it at BUILD time, while
# regenerating it needs live Firestore credentials. Without this negation the
# blanket *.json rule drops it, and a fresh clone silently builds a homepage
# whose hero falls back to the still image.
!config/hero-promo-videos.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

.env.production
.env*.local

# local AI/editor workflow files
.agents/

# Skyline thumbnail pipeline dry-run reports (local review artifacts only)
outputs/skyline-dryrun/

# Local scratch, caches and agent working dirs — never release source.
outputs/
backups/

# Required site assets. The blanket website/img + website/fonts ignores above are
# there to keep bulk media out of the repo, but these specific files are part of
# REQUIRED_MANIFEST_PATHS (lib/WebsiteDeployer.js): without them a Vercel-run
# deploy packages a site with no fonts and no header logo. ~220 KB total.
!website/fonts/gately-v1-regular.woff2
!website/fonts/rationale-v1-regular.woff2
!website/fonts/special-elite-v20-latin-regular.woff2
!website/fonts/ibm-plex-mono-v20-latin-regular.woff2
!website/fonts/ibm-plex-mono-v20-latin-500.woff2
!website/fonts/ibm-plex-mono-v20-latin-700.woff2
!website/img/ue-logo-horiz.png
!website/img/ue-white-horiz.png
!website/img/square-ue.png
!website/img/digging-hero.jpg
!website/icon/favicon-32x32.png
!website/img/flyers/flyer1.jpg
!website/img/flyers/flyer2.jpg

# Never track the local secrets file (wallet JWK + service account key).
.env.local
